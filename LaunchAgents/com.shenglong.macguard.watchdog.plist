<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shenglong.macguard.watchdog</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/MacGuard</string>
    <key>ProgramArguments</key>
    <array>
        <string>MacGuard</string>
        <string>--watchdog</string>
    </array>
    <!-- Always running: relaunches the app only if it dies while armed -->
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.shenglong.macguard</string>
    </array>
</dict>
</plist>
